# ─────────────────────────────────────────────────────────────────────────
#  Wootrico v2 — variáveis do docker-compose.coolify.yml
#
#  NO COOLIFY você NÃO precisa deste arquivo: cole o compose e preencha
#  as variáveis na aba "Environment Variables".
#
#  FORA DO COOLIFY (Portainer / Dockge / docker compose puro):
#    1. copie para `.env` na mesma pasta do docker-compose.coolify.yml
#    2. preencha os campos vazios
#    3. docker compose -f docker-compose.coolify.yml up -d
#
#  NUNCA faça commit do `.env` preenchido.
# ─────────────────────────────────────────────────────────────────────────

# ══ OBRIGATÓRIO ══════════════════════════════════════════════════════════

# Senha do Postgres embarcado. Invente uma forte — só é usada internamente.
# Evite os caracteres @ : / ? # nela (a senha vai dentro de uma URL).
POSTGRES_PASSWORD=

# Senha do RabbitMQ embarcado. Mesma recomendação acima.
RABBITMQ_PASSWORD=

# URL pública do painel, com https:// e SEM barra no final.
# Tem que ser o mesmo domínio configurado no proxy (Coolify → aba Domains).
# É daqui que saem as URLs de webhook entregues ao Chatwoot e ao provedor.
PUBLIC_BASE_URL=https://wootrico.suaempresa.com

# Segredo de sessão/JWT — mínimo 32 caracteres.
#   gere com:  openssl rand -base64 48
JWT_SECRET=

# Chave de criptografia das credenciais salvas — precisa decodificar para
# EXATAMENTE 32 bytes. Não invente à mão.
#   gere com:  openssl rand -base64 32
# ⚠️ Guarde-a. Trocá-la depois invalida tudo que já foi salvo criptografado.
APP_ENCRYPTION_KEY=

# ══ OPCIONAL — só mexa se precisar ═══════════════════════════════════════

POSTGRES_USER=wootrico
POSTGRES_DB=wootrico
RABBITMQ_USER=wootrico

# Teto de memória do RabbitMQ embarcado. Em VPS de 2 GB, baixe para 512m.
RABBITMQ_MEMORY_LIMIT=1g

# info | debug | warn | error  (use `debug` para investigar problemas)
LOG_LEVEL=info

# Fixe uma versão em vez de :latest se quiser controlar quando atualizar.
# WOOTRICO_IMAGE=ericoautomacao/wootrico-v2:0.2.2

# 🚫 NÃO defina LICENSE_SERVER_URL — já vem embutida na imagem.
#    Declará-la sobrescreve o valor correto e derruba a licença.
